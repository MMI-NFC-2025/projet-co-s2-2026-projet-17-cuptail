---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Historique">
  <section class="relative min-h-[calc(100vh-64px)] overflow-hidden bg-[radial-gradient(circle_at_15%_12%,rgba(60,238,223,0.25),transparent_28%),radial-gradient(circle_at_85%_20%,rgba(255,208,77,0.28),transparent_26%),var(--color-green-soft)] px-4 py-8">
    <div class="relative z-10 mx-auto max-w-3xl">
      <div class="mb-8 flex items-start justify-between gap-4">
        <div>
          <p class="mb-2 text-sm font-bold uppercase tracking-[0.18em] text-[var(--color-turquoise-dark)]">Mon espace</p>
          <h1 class="page-title">Historique</h1>
          <p class="mt-3 max-w-[310px] text-[15px] leading-6 text-black/60">Retrouvez les boissons consultées récemment.</p>
        </div>

        <button id="clear-history" class="hidden items-center gap-2 rounded-full bg-white/90 px-4 py-2 text-sm font-bold text-brand-red shadow-button backdrop-blur transition hover:scale-105 active:scale-95" type="button">
          <img src="/icons/account/trash.svg" class="h-5 w-5" alt="" />
          Effacer
        </button>
      </div>

      <div id="history-content"></div>
    </div>
  </section>
</Layout>

<script>
  import { pb, getUserHistory, deleteHistoryItem, clearUserHistory } from '../../backend/backend.js';

  const content = document.querySelector('#history-content');
  const clearButton = document.querySelector('#clear-history');

  function formatDateLabel(dateString: string) {
    const date = new Date(dateString);
    const today = new Date();
    const yesterday = new Date();

    yesterday.setDate(today.getDate() - 1);

    if (date.toDateString() === today.toDateString()) return 'Consulté aujourd’hui';
    if (date.toDateString() === yesterday.toDateString()) return 'Consulté hier';

    return date.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
  }

  function getBoisson(item: any) {
    return item.expand?.boisson || null;
  }

  function groupHistory(history: any[]) {
    return history.reduce((groups: Record<string, any[]>, item: any) => {
      const label = formatDateLabel(item.viewed_at || item.updated || item.created);
      groups[label] ||= [];
      groups[label].push(item);
      return groups;
    }, {});
  }

  function renderEmpty() {
    if (!content) return;

    clearButton?.classList.add('hidden');
    clearButton?.classList.remove('inline-flex');

    content.innerHTML = `
      <div class="flex min-h-[560px] flex-col items-center justify-center text-center">
        <div class="relative mb-8 h-[230px] w-[260px]">
          <div class="absolute inset-0 rounded-full bg-white/40 blur-2xl"></div>

          <img src="/images/history-glass.png" class="animate-history-glass relative z-20 h-full w-full object-contain drop-shadow-[0_16px_22px_rgba(0,0,0,0.14)]" alt="" />

          <span class="animate-history-drop absolute bottom-[72px] left-1/2 z-30 h-[13px] w-[9px] -translate-x-7 rounded-full rounded-bl-none bg-gradient-to-b from-brand-turquoise to-[var(--color-turquoise-dark)] shadow-[0_0_14px_rgba(60,238,223,0.45)]"></span>
          <span class="animate-history-drop absolute bottom-[72px] left-1/2 z-30 h-[11px] w-[8px] translate-x-3 rounded-full rounded-bl-none bg-gradient-to-b from-brand-turquoise to-[var(--color-turquoise-dark)] shadow-[0_0_14px_rgba(60,238,223,0.45)] [animation-delay:.55s]"></span>
          <span class="animate-history-drop absolute bottom-[72px] left-1/2 z-30 h-[10px] w-[7px] translate-x-10 rounded-full rounded-bl-none bg-gradient-to-b from-brand-turquoise to-[var(--color-turquoise-dark)] shadow-[0_0_14px_rgba(60,238,223,0.45)] [animation-delay:1.1s]"></span>

          <span class="animate-history-sparkle absolute left-[52px] top-10 z-30 h-[9px] w-[9px] bg-[#FFC42F] [clip-path:polygon(50%_0%,62%_35%,100%_50%,62%_65%,50%_100%,38%_65%,0%_50%,38%_35%)]"></span>
          <span class="animate-history-sparkle absolute right-12 top-[70px] z-30 h-[9px] w-[9px] bg-[#FFC42F] [animation-delay:.7s] [clip-path:polygon(50%_0%,62%_35%,100%_50%,62%_65%,50%_100%,38%_65%,0%_50%,38%_35%)]"></span>
          <span class="animate-history-sparkle absolute bottom-12 right-[74px] z-30 h-[9px] w-[9px] bg-[#FFC42F] [animation-delay:1.2s] [clip-path:polygon(50%_0%,62%_35%,100%_50%,62%_65%,50%_100%,38%_65%,0%_50%,38%_35%)]"></span>
        </div>

        <div class="rounded-[28px] border border-white/75 bg-white/90 p-8 text-center shadow-card backdrop-blur">
          <h2 class="text-[21px] font-bold text-black">Aucune boisson dans votre historique</h2>
          <p class="mt-4 text-[15px] leading-6 text-black/55">Les recettes que vous consultez apparaîtront ici.</p>
        </div>

        <a href="/boissons" class="mt-10 inline-flex rounded-full bg-brand-turquoise px-10 py-4 text-[16px] font-bold text-black shadow-button transition hover:scale-105 active:scale-95">Découvrir les boissons</a>
      </div>
    `;
  }

  function renderHistory(history: any[]) {
    if (!content) return;

    if (!history.length) {
      renderEmpty();
      return;
    }

    clearButton?.classList.remove('hidden');
    clearButton?.classList.add('inline-flex');

    const groups = groupHistory(history);

    content.innerHTML = `
      <div class="mb-7 rounded-[26px] border border-white/75 bg-white/90 p-5 shadow-card backdrop-blur">
        <p class="text-sm font-bold text-[var(--color-turquoise-dark)]">${history.length} boisson${history.length > 1 ? 's' : ''} consultée${history.length > 1 ? 's' : ''}</p>
        <p class="mt-1 text-sm text-black/50">Votre historique est mis à jour automatiquement.</p>
      </div>

      ${Object.entries(groups).map(([label, items]) => `
        <section class="mb-8">
          <h2 class="mb-4 text-center text-[16px] font-bold text-black">${label}</h2>

          <div class="overflow-hidden rounded-[18px] border border-white/75 bg-white/90 shadow-card backdrop-blur">
            ${items.map((item) => {
              const boisson = getBoisson(item);
              if (!boisson) return '';

              return `
                <article class="flex items-center justify-between gap-3 border-b border-black/10 px-4 py-3 last:border-b-0">
                  <a href="/boissons/${boisson.slug}" class="flex min-w-0 flex-1 items-center gap-3">
                    <span class="h-3 w-3 shrink-0 rounded-full bg-brand-turquoise shadow-[0_0_0_8px_rgba(60,238,223,0.18)]"></span>

                    <div class="min-w-0">
                      <h3 class="truncate text-[16px] font-bold text-black">${boisson.nom_boisson}</h3>
                      <p class="text-[12px] text-black/50">Consulté ${item.view_count || 1} fois</p>
                    </div>
                  </a>

                  <div class="relative">
                    <button class="history-menu-button grid h-8 w-8 place-items-center rounded-full text-xl leading-none text-black/40 transition hover:bg-black/5" type="button" aria-label="Options">⋮</button>

                    <div class="history-menu absolute right-0 top-9 z-20 hidden w-[170px] overflow-hidden rounded-2xl bg-white shadow-panel">
                      <a href="/boissons/${boisson.slug}" class="block px-4 py-3 text-sm font-bold text-black hover:bg-neutral-100">Voir la recette</a>
                      <button class="delete-history-item block w-full px-4 py-3 text-left text-sm font-bold text-brand-red hover:bg-neutral-100" type="button" data-id="${item.id}">Supprimer</button>
                    </div>
                  </div>
                </article>
              `;
            }).join('')}
          </div>
        </section>
      `).join('')}
    `;
  }

  async function loadHistory() {
    if (!content) return;

    if (!pb.authStore.isValid || !pb.authStore.model) {
      content.innerHTML = `
        <div class="rounded-[28px] border border-white/75 bg-white/90 p-8 text-center shadow-card backdrop-blur">
          <h2 class="text-xl font-bold text-black">Connectez-vous pour voir votre historique</h2>
          <p class="mt-3 text-sm text-black/50">Votre historique est lié à votre compte.</p>
          <a href="/login" class="mt-6 inline-flex rounded-full bg-brand-turquoise px-6 py-3 text-sm font-bold text-black shadow-button">Se connecter</a>
        </div>
      `;
      return;
    }

    const history = await getUserHistory();
    renderHistory(history);
  }

  document.addEventListener('click', async (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const menuButton = target.closest('.history-menu-button');
    const deleteButton = target.closest('.delete-history-item');

    if (menuButton) {
      const menu = menuButton.parentElement?.querySelector('.history-menu');
      document.querySelectorAll('.history-menu').forEach((item) => {
        if (item !== menu) item.classList.add('hidden');
      });
      menu?.classList.toggle('hidden');
      return;
    }

    if (deleteButton) {
      const id = deleteButton.getAttribute('data-id');
      if (id) {
        await deleteHistoryItem(id);
        await loadHistory();
      }
      return;
    }

    document.querySelectorAll('.history-menu').forEach((item) => item.classList.add('hidden'));
  });

  clearButton?.addEventListener('click', async () => {
    if (!confirm('Voulez-vous vraiment effacer tout l’historique ?')) return;
    await clearUserHistory();
    await loadHistory();
  });

  document.addEventListener('DOMContentLoaded', loadHistory);
</script>

<style is:global>
  @keyframes history-glass-float {
    0%, 100% { transform: rotate(-2deg) translateY(0); }
    50% { transform: rotate(2deg) translateY(-8px); }
  }

  @keyframes history-drop {
    0% { transform: translateY(0) scale(0.5); opacity: 0; }
    20% { opacity: 1; }
    100% { transform: translateY(-95px) scale(1); opacity: 0; }
  }

  @keyframes history-sparkle {
    0%, 100% { opacity: 0.25; transform: scale(0.8) rotate(0deg); }
    50% { opacity: 1; transform: scale(1.15) rotate(18deg); }
  }

  .animate-history-glass {
    animation: history-glass-float 3.4s ease-in-out infinite;
    transform-origin: center bottom;
  }

  .animate-history-drop {
    animation: history-drop 2.2s ease-out infinite;
  }

  .animate-history-sparkle {
    animation: history-sparkle 2.4s ease-in-out infinite;
  }
</style>