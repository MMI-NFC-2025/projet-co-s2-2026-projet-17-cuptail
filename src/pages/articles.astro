---
import Layout from '../layouts/Layout.astro';
import { getArticles } from '../backend/backend.js';
import ArticleCard from '../components/ArticleCard.astro';

const articles = await getArticles();

const categories = [
  'Tous',
  'Nutrition',
  'Ingrédients',
  'Astuces',
  'Hydratation',
  'Énergie'
];
---

<Layout title="Conseils & articles">
  <section class="min-h-[calc(100vh-64px)] bg-mint px-4 py-8">
    <div class="mx-auto max-w-5xl">
      <div class="mb-8 flex items-start justify-between gap-4">
        <div>
          <h1 class="page-title">Conseils & articles</h1>

          <p class="page-subtitle mt-3 max-w-[320px]">
            Des idées, astuces et infos pour mieux profiter de vos boissons.
          </p>
        </div>

        <button
          class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-white shadow-button"
          type="button"
          aria-label="Rechercher"
        >
          <img src="/icons/search.svg" class="h-5 w-5" alt="" />
        </button>
      </div>

      <div class="mb-8 flex gap-3 overflow-x-auto pb-2 scrollbar-hide">
        {categories.map((category, index) => (
          <button
            class={`article-filter shrink-0 rounded-full px-5 py-2 text-sm font-bold shadow-button ${
              index === 0
                ? 'bg-brand-turquoise text-white'
                : 'bg-white text-black'
            }`}
            type="button"
            data-category={category.toLowerCase()}
          >
            {category}
          </button>
        ))}
      </div>

      <div id="articles-grid" class="grid gap-8 md:grid-cols-2">
        {articles.map((article) => (
          <ArticleCard article={article} variant="grid" />
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  const filterButtons = document.querySelectorAll('.article-filter');
  const articleCards = document.querySelectorAll('.article-card');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const selectedCategory = button.dataset.category?.toLowerCase();

      filterButtons.forEach((item) => {
        item.classList.remove('bg-brand-turquoise', 'text-white');
        item.classList.add('bg-white', 'text-black');
      });

      button.classList.remove('bg-white', 'text-black');
      button.classList.add('bg-brand-turquoise', 'text-white');

      articleCards.forEach((card) => {
        const cardCategory = card.dataset.category?.toLowerCase() || '';

        if (
          selectedCategory === 'tous' ||
          cardCategory.includes(selectedCategory)
        ) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });
</script>