---
import Layout from '../../layouts/Layout.astro';
import { getArticles, getFileUrl } from '../../backend/backend.js';

export async function getStaticPaths() {
  const articles = await getArticles();

  return articles.map((article) => ({
    params: {
      slug: article.slug,
    },
    props: {
      article,
    },
  }));
}

const { article } = Astro.props;

const imageUrl = article.image
  ? getFileUrl(article, article.image)
  : '/images/placeholder-drink.png';

const sections = Array.isArray(article.sections) ? article.sections : [];
const encadreItems = Array.isArray(article.encadre_items) ? article.encadre_items : [];

function formatDate(date: string) {
  if (!date) return '';

  const parsedDate = new Date(date);
  if (Number.isNaN(parsedDate.getTime())) return '';

  return parsedDate.toLocaleDateString('fr-FR');
}
---

<Layout title={article.titre}>
  <article class="min-h-[calc(100vh-64px)] bg-white px-4 py-6">
    <div class="mx-auto max-w-3xl">
      <a href="/articles" class="mb-8 inline-flex items-center gap-4 text-[16px] italic text-black md:text-[22px]">
        <span class="grid h-11 w-11 place-items-center rounded-full bg-white shadow-soft md:h-14 md:w-14">
          <img src="/icons/arrow-back.svg" class="h-5 w-5 md:h-6 md:w-6" alt="" />
        </span>

        Retour aux conseils & articles
      </a>

      <div class="relative mt-8">
        <img
          src={imageUrl}
          alt={article.titre}
          class="h-[190px] w-full rounded-[24px] object-cover md:h-[360px]"
        />

        {article.badge_2 && (
          <span class="absolute -bottom-4 left-5 rounded-full bg-white px-7 py-2 text-sm font-bold text-brand-turquoise shadow-soft md:px-9 md:py-3 md:text-[20px]">
            {article.badge_2}
          </span>
        )}
      </div>

      <div class="mt-12 flex items-center justify-between text-[15px] text-neutral-400 md:text-[17px]">
        <span>{formatDate(article.date_publication || article.created)}</span>

        <span class="inline-flex items-center gap-1">
          <img src="/icons/clock.svg" class="h-4 w-4" alt="" />
          {article.temps_lecture}
        </span>
      </div>
<h1 class="mt-7 text-[28px] font-bold leading-tight text-black md:text-[42px]">
  {article.titre || article.titre_court || 'Titre manquant'}
</h1>
      

      <p class="mt-3 text-[18px] leading-6 text-neutral-400 md:text-[22px]">
        {article.description_courte}
      </p>

      <div class="my-8 h-px w-full bg-brand-turquoise"></div>

      {article.intro && (
        <p class="text-[17px] leading-7 text-black md:text-[19px]">
          <Fragment set:html={article.intro} />
        </p>
      )}

      <div class="mt-10 space-y-12">
        {sections.map((section, index) => (
          <>
            <section>
              <h2 class="border-l-2 border-[var(--color-turquoise-dark)] pl-6 text-[20px] font-bold leading-6 text-[var(--color-turquoise-dark)] md:text-[24px]">
                {section.title}
              </h2>

              <p class="mt-6 pl-6 text-[17px] leading-7 text-black md:text-[19px]">
                {section.body}
              </p>
            </section>

            {index === 0 && article.encadre_titre && encadreItems.length > 0 && (
              <aside class="rounded-[18px] bg-seaBreeze p-7 shadow-card">
                <h3 class="text-[20px] font-bold text-[var(--color-turquoise-dark)]">
                  {article.encadre_titre}
                </h3>

                <ul class="mt-5 space-y-4">
                  {encadreItems.map((item) => (
                    <li class="flex gap-4 text-[17px] text-black">
                      <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-[var(--color-turquoise-dark)]"></span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </aside>
            )}
          </>
        ))}
      </div>

      <section class="mt-14 rounded-[24px] bg-seaBreeze p-6 shadow-card md:p-8">
        <div class="flex items-center gap-5">
          <img
            src="/images/placeholder-drink.png"
            alt=""
            class="h-20 w-20 rounded-full object-cover"
          />

          <div>
            <h2 class="text-[18px] font-bold text-black">
              Envie d’une boisson adaptée à aujourd’hui ?
            </h2>

            <p class="mt-3 text-[14px] leading-6 text-brand-warmGray">
              Découvrez celle qui correspond à la météo et à votre énergie du moment.
            </p>

            <a
              href="/boissons"
              class="mt-5 inline-flex rounded-full bg-brand-turquoise px-6 py-3 text-sm font-bold text-white shadow-button"
            >
              Trouver ma boisson
            </a>
          </div>
        </div>
      </section>
    </div>
  </article>
</Layout>