---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import WeatherClient from '../components/WeatherClient.astro';
import DrinkCard from '../components/DrinkCard.astro';
import QuizSection from '../components/QuizSection.astro';
import ArticleCard from '../components/ArticleCard.astro';

import { getBoissons, getCategories, getFeaturedArticles } from '../backend/backend.js';
import CategoriesSection from '../components/CategoriesSection.astro';


const boissons = await getBoissons();
const categories = await getCategories();
const nouveautes = boissons.filter((boisson) => boisson.is_new).slice(0, 12);
const articles = await getFeaturedArticles();

const partners = [
  { name: 'La Félicita', image: '/images/partners/la-felicita.png', url: 'https://www.lafelicita.fr' },
  { name: 'IUT Nord Franche-Comté', image: '/images/partners/iut-nfc.png', url: 'https://www.iut-nfc.univ-fcomte.fr' },
  { name: 'Ville de Montbéliard', image: '/images/partners/ville-de-montbeliard.jpg', url: 'https://www.facebook.com/MontbeliardOfficiel/' },
  { name: 'La Vie Au Naturel ', image: '/images/partners/la-vie-au-naturel.webp', url: 'https://marceletfils.com/pages/montbeliard' },
  { name: 'Energie de la vie', image: '/images/partners/energiedelavie.webp', url: 'https://www.energiedelavie.fr/boissons/' },
];

---

<Layout title="Accueil">
  <Hero />

  <WeatherClient />

<section class="bg-[#F7FFF4] px-4 py-10 md:py-16">
  <div class="mx-auto max-w-6xl">
    <div class="mb-6 md:mb-10">
      <h2 class="section-title">Tu préfères autre chose ?</h2>
      <p class="mt-2 max-w-[520px] text-[15px] font-medium leading-6 text-black/50 md:text-[17px]">
        Choisis rapidement une ambiance ou personnalise ta recherche en quelques secondes.
      </p>
    </div>

    <div class="grid gap-4 md:grid-cols-3 md:gap-6">
      <a href="/boissons?temperature=froid" class="group grid min-h-[150px] grid-cols-[1fr_110px] items-center gap-3 overflow-hidden rounded-[28px] bg-seaBreeze p-5 shadow-card transition hover:-translate-y-1 hover:shadow-panel md:min-h-[190px] md:grid-cols-1 md:grid-rows-[auto_1fr] md:p-6 lg:grid-cols-[1fr_140px] lg:grid-rows-1">
        <div class="min-w-0">
          <h3 class="text-[28px] font-bold leading-8 text-black md:text-[30px] lg:text-[32px]">Froid</h3>
          <p class="mt-2 text-[15px] font-bold leading-5 text-black/50 md:text-[16px] lg:text-[17px]">Boissons fraîches et légères.</p>
        </div>
        <img class="h-[90px] w-[110px] object-contain transition group-hover:scale-110 md:mx-auto md:h-[105px] md:w-[135px] lg:h-[120px] lg:w-[150px]" src="/icons/weather/ice.svg" alt="" />
      </a>

      <a href="/boissons?temperature=chaud" class="group grid min-h-[150px] grid-cols-[1fr_110px] items-center gap-3 overflow-hidden rounded-[28px] bg-cottonCandy p-5 shadow-card transition hover:-translate-y-1 hover:shadow-panel md:min-h-[190px] md:grid-cols-1 md:grid-rows-[auto_1fr] md:p-6 lg:grid-cols-[1fr_140px] lg:grid-rows-1">
        <div class="min-w-0">
          <h3 class="text-[28px] font-bold leading-8 text-black md:text-[30px] lg:text-[32px]">Chaud</h3>
          <p class="mt-2 text-[15px] font-bold leading-5 text-black/50 md:text-[16px] lg:text-[17px]">Boissons chaudes et réconfortantes.</p>
        </div>
        <img class="h-[90px] w-[110px] object-contain transition group-hover:scale-110 md:mx-auto md:h-[105px] md:w-[135px] lg:h-[120px] lg:w-[150px]" src="/icons/weather/hot.svg" alt="" />
      </a>

      <a href="#quiz-section" class="group grid min-h-[150px] grid-cols-[1fr_110px] items-center gap-3 overflow-hidden rounded-[28px] bg-lavender p-5 shadow-card transition hover:-translate-y-1 hover:shadow-panel md:min-h-[190px] md:grid-cols-1 md:grid-rows-[auto_1fr] md:p-6 lg:grid-cols-[1fr_140px] lg:grid-rows-1">
        <div class="min-w-0">
          <h3 class="text-[28px] font-bold leading-8 text-black md:text-[30px] lg:text-[32px]">Personnaliser</h3>
          <p class="mt-2 text-[15px] font-bold leading-5 text-black/50 md:text-[16px] lg:text-[17px]">Réponds à 3 questions rapides.</p>
        </div>
        <img class="h-[90px] w-[110px] object-contain transition group-hover:scale-110 md:mx-auto md:h-[105px] md:w-[135px] lg:h-[120px] lg:w-[150px]" src="/icons/weather/personalis.svg" alt="" />
      </a>
    </div>
  </div>
</section>

 <CategoriesSection categories={categories} />

<QuizSection />


<section class="bg-white px-4 pb-14 md:pb-20">
  <div class="mx-auto max-w-6xl">
    <div class="mb-6 flex items-center justify-between md:mb-10">
      <h2 class="section-title">Dernières nouveautés</h2>

      <div class="hidden gap-3 md:flex">
        <button id="news-prev" class="grid h-10 w-10 place-items-center rounded-full bg-white shadow-button" type="button">
          <img src="/icons/arrow-left.svg" class="h-4 w-4" alt="" />
        </button>

        <button id="news-next" class="grid h-10 w-10 place-items-center rounded-full bg-white shadow-button" type="button">
          <img src="/icons/arrow-right.svg" class="h-4 w-4" alt="" />
        </button>
      </div>
    </div>

    <div
      id="news-carousel"
      class="flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth pb-4 md:gap-6 xl:gap-8 scrollbar-hide"
    >
      {(nouveautes.length ? nouveautes : boissons.slice(0, 12)).slice(0, 12).map((boisson) => (
        <div class="snap-start">
          <DrinkCard boisson={boisson} />
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const carousel = document.querySelector('#news-carousel');
  const prev = document.querySelector('#news-prev');
  const next = document.querySelector('#news-next');

  const scrollAmount = 210;

  prev?.addEventListener('click', () => {
    carousel?.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
  });

  next?.addEventListener('click', () => {
    carousel?.scrollBy({ left: scrollAmount, behavior: 'smooth' });
  });
</script>

  <section class="bg-white px-4 pb-14 md:pb-20">
  <div class="mx-auto max-w-6xl">
    <div class="mb-6 flex items-center justify-between md:mb-10">
      <h2 class="section-title">Articles & conseils</h2>

      <a href="/articles" class="hidden text-sm font-bold text-brand-turquoise md:inline">
        Voir tout
      </a>
    </div>

    <div class="flex snap-x snap-mandatory gap-5 overflow-x-auto scroll-smooth pb-4 scrollbar-hide md:gap-7">
      {articles.map((article) => (
        <div class="snap-start">
          <ArticleCard article={article} />
        </div>
      ))}
    </div>

    <a
      href="/articles"
      class="mt-6 inline-flex rounded-full bg-brand-turquoise px-6 py-3 text-sm font-bold text-black shadow-button md:hidden"
    >
      Voir tout
    </a>
  </div>
</section>

<section class="overflow-hidden bg-[#F7FFF4] px-4 py-12 md:py-16">
  <div class="mx-auto max-w-6xl text-center">
    <h2 class="section-title">Nos partenaires</h2>
    <p class="mx-auto mt-3 max-w-[520px] text-[15px] font-medium leading-6 text-black/50 md:text-[17px]">Des lieux et acteurs locaux qui partagent notre envie de mieux boire au quotidien.</p>
  </div>

  <div class="relative mt-9 overflow-x-hidden py-4">
    <div class="pointer-events-none absolute left-0 top-0 z-10 h-full w-16 bg-gradient-to-r from-[#F7FFF4] to-transparent"></div>
    <div class="pointer-events-none absolute right-0 top-0 z-10 h-full w-16 bg-gradient-to-l from-[#F7FFF4] to-transparent"></div>

    <div class="flex w-max gap-5 [animation:partners-scroll_28s_linear_infinite] hover:[animation-play-state:paused] md:gap-7">
      {[...partners, ...partners].map((partner) => (
        <a href={partner.url} target="_blank" rel="noreferrer" class="flex min-w-[190px] flex-col items-center justify-center rounded-[26px] bg-white/95 px-5 py-6 shadow-card transition hover:-translate-y-1 hover:shadow-panel md:min-w-[215px]">
          <img src={partner.image} alt={partner.name} class="h-16 w-16 rounded-full border-[3px] border-brand-turquoise bg-white object-cover" />
          <span class="mt-3 max-w-[150px] text-center text-[13px] font-bold leading-5 text-black md:text-[14px]">{partner.name}</span>
        </a>
      ))}
    </div>
  </div>
</section>


<style is:global>
  @keyframes partners-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
</style>
</Layout>