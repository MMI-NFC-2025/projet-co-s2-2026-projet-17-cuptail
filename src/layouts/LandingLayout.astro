---
import LandingHeader from '../components/LandingHeader.astro';
import LandingFooter from '../components/LandingFooter.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Cielixir',
  description = 'Découvre Cielixir, une application de recettes de boissons adaptées à la météo.'
} = Astro.props;
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>

  <body class="bg-white font-sans text-black">
    <LandingHeader />

    <main>
      <slot />
    </main>

    <LandingFooter />
  </body>
</html>